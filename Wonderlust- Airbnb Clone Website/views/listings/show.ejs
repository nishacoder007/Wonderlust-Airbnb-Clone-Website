<% layout("layouts/boilerplate") %>

<div style="max-width: 1000px; margin: 0 auto;">
  <!-- Listing Title -->
  <h1 class="show-title"><%= listing.title %></h1>
  
  <!-- Header Meta -->
  <div class="show-header-meta">
    <div>
      <span><i class="fa-solid fa-star"></i> <%= listing.reviews.length > 0 ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) : "New" %></span>
      &middot;
      <a href="#reviews" style="text-decoration: underline;"><%= listing.reviews.length %> reviews</a>
      &middot;
      <span><%= listing.location %>, <%= listing.country %></span>
    </div>
    <div>
      <span class="category-tag">
        <% if (listing.category === 'Beachfront') { %><i class="fa-solid fa-umbrella-beach"></i>
        <% } else if (listing.category === 'Cabins') { %><i class="fa-solid fa-house-chimney"></i>
        <% } else if (listing.category === 'Trending') { %><i class="fa-solid fa-fire"></i>
        <% } else if (listing.category === 'Castles') { %><i class="fa-solid fa-fort-awesome"></i>
        <% } else if (listing.category === 'Amazing Pools') { %><i class="fa-solid fa-water-ladder"></i>
        <% } else if (listing.category === 'Camping') { %><i class="fa-solid fa-campground"></i>
        <% } else if (listing.category === 'Farms') { %><i class="fa-solid fa-tractor"></i>
        <% } else if (listing.category === 'Arctic') { %><i class="fa-regular fa-snowflake"></i>
        <% } else if (listing.category === 'Rooms') { %><i class="fa-solid fa-bed"></i>
        <% } else if (listing.category === 'Mountains') { %><i class="fa-solid fa-mountain"></i>
        <% } else if (listing.category === 'Iconic Cities') { %><i class="fa-solid fa-mountain-city"></i>
        <% } %>
        <%= listing.category %>
      </span>
    </div>
  </div>

  <!-- Showcase Image Gallery -->
  <div class="show-img-gallery">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" />
  </div>

  <!-- Dual Column Layout -->
  <div class="show-layout">
    <!-- Left Column: Details & Reviews -->
    <div>
      <!-- Host Profile Info -->
      <div class="host-details">
        <h2 class="host-title">Entire home hosted by <%= listing.owner.username %></h2>
        <p style="color: var(--gray-text); font-size: 14px;">16 guests &middot; 8 bedrooms &middot; 10 beds &middot; 8.5 baths</p>
      </div>

      <!-- Description Content -->
      <div class="description-section">
        <p><%= listing.description %></p>
      </div>

      <!-- Edit/Delete Action Row (Owner only) -->
      <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="action-buttons-row">
          <a href="/listings/<%= listing._id %>/edit" class="btn-secondary">
            <i class="fa-solid fa-pen-to-square"></i> Edit Listing
          </a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this listing permanently?');">
            <button type="submit" class="btn-danger">
              <i class="fa-solid fa-trash-can"></i> Delete Listing
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Container -->
      <div class="reviews-section" id="reviews">
        <h3 class="reviews-section-title">
          <i class="fa-solid fa-star" style="color: var(--dark-color); margin-right: 8px;"></i>
          <%= listing.reviews.length > 0 ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) : "No" %> &middot; <%= listing.reviews.length %> Reviews
        </h3>

        <!-- Post a Review Form -->
        <% if (currUser) { %>
          <div class="review-form">
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
              
              <!-- 5-Star Rating Switcher -->
              <div class="form-group" style="margin-bottom: 12px;">
                <label>Rating</label>
                <div class="rating-star-input">
                  <input type="radio" id="star5" name="review[rating]" value="5" required />
                  <label for="star5" title="5 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star4" name="review[rating]" value="4" />
                  <label for="star4" title="4 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star3" name="review[rating]" value="3" />
                  <label for="star3" title="3 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star2" name="review[rating]" value="2" />
                  <label for="star2" title="2 stars"><i class="fa-solid fa-star"></i></label>
                  <input type="radio" id="star1" name="review[rating]" value="1" />
                  <label for="star1" title="1 star"><i class="fa-solid fa-star"></i></label>
                </div>
                <div class="invalid-feedback">Please select a rating rating.</div>
              </div>

              <!-- Comment input field -->
              <div class="form-group">
                <label for="comment">Comment</label>
                <textarea 
                  name="review[comment]" 
                  id="comment" 
                  cols="30" 
                  rows="4" 
                  placeholder="Share details of your experience..." 
                  required
                ></textarea>
                <div class="invalid-feedback">Please enter a review comment.</div>
              </div>

              <button type="submit" class="btn-primary" style="padding: 10px 20px; font-size: 14px;">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <div style="background-color: var(--light-gray); border: 1px dashed var(--border-color); border-radius: var(--radius-md); padding: 20px; text-align: center; margin-bottom: 32px;">
            <p style="color: var(--gray-text); font-size: 14px;">
              <a href="/login" style="color: var(--brand-color); font-weight: 600; text-decoration: underline;">Log In</a> or 
              <a href="/signup" style="color: var(--brand-color); font-weight: 600; text-decoration: underline;">Sign Up</a> to write a review.
            </p>
          </div>
        <% } %>

        <!-- Existing Reviews List -->
        <% if (listing.reviews.length > 0) { %>
          <div class="reviews-list-grid">
            <% for (let review of listing.reviews) { %>
              <div class="review-card">
                <div class="review-card-header">
                  <div class="review-author">
                    <div class="review-author-avatar">
                      <%= review.author.username.substring(0,2).toUpperCase() %>
                    </div>
                    <div>
                      <div class="review-author-name"><%= review.author.username %></div>
                      <div class="review-date"><%= new Date(review.createdAt).toLocaleDateString("en-US", {month: 'long', year: 'numeric'}) %></div>
                    </div>
                  </div>
                  <!-- Stars Row -->
                  <div class="review-stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="<%= i <= review.rating ? 'fa-solid' : 'fa-regular' %> fa-star"></i>
                    <% } %>
                  </div>
                </div>
                <!-- Comment text -->
                <p class="review-comment"><%= review.comment %></p>
                
                <!-- Review Deletion Form (Author only) -->
                <% if (currUser && review.author._id.equals(currUser._id)) { %>
                  <form 
                    action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" 
                    method="POST" 
                    class="review-delete-form"
                  >
                    <button type="submit" class="review-delete-btn">
                      <i class="fa-regular fa-trash-can"></i> Delete
                    </button>
                  </form>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } else { %>
          <p style="color: var(--gray-text); font-size: 14px; font-style: italic;">No reviews posted yet. Be the first to review this place!</p>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Interactive Booking Widget & Leaflet Map -->
    <div>
      <!-- Booking Reservation Box -->
      <div class="booking-widget-card">
        <div class="widget-price-row">
          <div class="widget-price">
            $<%= listing.price.toLocaleString("en-US") %> <span>/ night</span>
          </div>
          <div style="font-size: 12px; font-weight: 600;">
            <i class="fa-solid fa-star"></i> <%= listing.reviews.length > 0 ? (listing.reviews.reduce((acc, r) => acc + r.rating, 0) / listing.reviews.length).toFixed(1) : "New" %>
          </div>
        </div>

        <!-- Reservation dates -->
        <div class="booking-form-grid">
          <div class="booking-form-item">
            <label for="checkin">Check-In</label>
            <input type="date" id="checkin" value="2026-06-15" />
          </div>
          <div class="booking-form-item">
            <label for="checkout">Check-Out</label>
            <input type="date" id="checkout" value="2026-06-22" />
          </div>
          <div class="booking-form-item full-width">
            <label for="guests">Guests</label>
            <select id="guests">
              <option value="1">1 guest</option>
              <option value="2" selected>2 guests</option>
              <option value="3">3 guests</option>
              <option value="4">4 guests</option>
            </select>
          </div>
        </div>

        <button class="booking-btn" onclick="alert('Thank you for booking! This is a simulated booking interface.')">Reserve</button>
        <p class="widget-subtext">You won't be charged yet</p>
        
        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 20px; font-size: 14px; border-top: 1px solid var(--border-color); padding-top: 16px;">
          <div style="display: flex; justify-content: space-between; color: var(--light-dark);">
            <span>$<%= listing.price.toLocaleString("en-US") %> x 7 nights</span>
            <span>$<%= (listing.price * 7).toLocaleString("en-US") %></span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--light-dark);">
            <span>Cleaning fee</span>
            <span>$45</span>
          </div>
          <div style="display: flex; justify-content: space-between; color: var(--light-dark);">
            <span>Service fee</span>
            <span>$90</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-weight: 700; border-top: 1px solid var(--border-color); padding-top: 12px; font-size: 15px; margin-top: 4px;">
            <span>Total before taxes</span>
            <span>$<%= (listing.price * 7 + 45 + 90).toLocaleString("en-US") %></span>
          </div>
        </div>
      </div>

      <!-- Interactive Map Box -->
      <div class="map-section" style="margin-top: 40px;">
        <h3 class="map-section-title">Where you'll be</h3>
        <!-- Mapping Container passing properties dynamically to map.js -->
        <div 
          id="map" 
          data-location="<%= listing.location %>, <%= listing.country %>" 
          data-title="<%= listing.title %>"
          data-coordinates="<%= JSON.stringify(listing.coordinates) %>"
        ></div>
      </div>
    </div>
  </div>
</div>
